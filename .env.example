# Local development overrides. Copy to .env only if you want to customise;
# `npm start` works with no .env file at all.

PORT=3000

# Signs session cookies. If omitted, a random secret is generated once and
# stored in DOCSYNC_DATA_DIR/.session-secret.
SESSION_SECRET=replace-with-a-long-random-string

# Where the SQLite database and session secret live.
DOCSYNC_DATA_DIR=./data

# Set to true when serving over HTTPS (Render sets this automatically via RENDER=true).
# COOKIE_SECURE=true
